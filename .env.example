# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: usada para convidar proprietários por e-mail. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do app (links dos e-mails de convite e redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mail (opcional). Sem estas duas, os avisos só ficam registrados em Admin → E-mails.
RESEND_API_KEY=
EMAIL_FROM=ImobAI <avisos@seudominio.com.br>
# Para onde vão os avisos à imobiliária (separe por vírgula). Vazio: e-mails dos logins admin.
EMAIL_IMOBILIARIA=
# Protege /api/cron/lembretes (Vercel Cron envia como Bearer)
CRON_SECRET=
